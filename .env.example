# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets must NEVER be committed.

# MongoDB connection string (Atlas)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mydatabase?retryWrites=true&w=majority

# Strong random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account (created automatically on first run if it doesn't exist)
ADMIN_USERNAME=EzyLoan
ADMIN_PASSWORD=Babulu@228844

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="ezyloan <contact@ezyloan.co.in>"

# Security alert inbox (failed logins / brute-force / rate-limit hits)
ALERT_EMAIL=dibyanshassociates@gmail.com

# Public site URL
NEXT_PUBLIC_SITE_URL=https://ezyloan.co.in
