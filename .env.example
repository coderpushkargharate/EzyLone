# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets must NEVER be committed.

# MongoDB connection string (Atlas)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mydatabase?retryWrites=true&w=majority
# Database name. The app IGNORES the name in the URL path above and opens this
# one (default "mydatabase" = production). STAGING MUST set its own, e.g.
# ezyloan_staging — ideally on a separate cluster with its own DB user.
DATABASE_NAME=

# Strong random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account. Only used to bootstrap an admin when the database has
# NO admin at all (and by scripts/reset-admin.mjs). Use a long, unique password
# (10+ chars, letters + numbers) and NEVER commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: HMAC key for the public-form anti-spam token. Defaults to JWT_SECRET.
FORM_GUARD_SECRET=

# How to read the REAL client IP (rate limits, IP blocks, India geo check).
# Set ONE of these to match your proxy. With neither, the IP comes from the
# spoofable X-Forwarded-For header and AUTOMATIC IP blocking is disabled.
#  - TRUSTED_IP_HEADER: a header your proxy OVERWRITES with the socket address:
#      nginx "proxy_set_header X-Real-IP $remote_addr;"  -> x-real-ip
#      behind Cloudflare                                 -> cf-connecting-ip
#  - TRUSTED_PROXY_HOPS: number of proxies that APPEND to X-Forwarded-For
#      (nginx "$proxy_add_x_forwarded_for" only -> 1; CDN + nginx -> 2)
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=

# Shared secret for POST /api/webhook/lead (send it as the x-webhook-secret
# header). REQUIRED: without it the endpoint returns 503 and creates nothing.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_LEAD_SECRET=
# Escape hatch ONLY: "true" re-opens /api/webhook/lead with no secret (public,
# rate-limited — anyone can create leads). Leave unset.
WEBHOOK_LEAD_ALLOW_OPEN=

# Facebook Lead Ads: App Secret used to verify webhook signatures. REQUIRED
# (here or saved in Admin → Automations → Facebook Lead Ads): without it every
# lead event is rejected with 403.
FACEBOOK_APP_SECRET=
# Escape hatch ONLY: "true" accepts unsigned events (logged; leads are saved only
# when the leadgen id resolves via the Graph API). Leave unset.
FACEBOOK_ALLOW_UNSIGNED=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email — Gmail (Google Workspace) via App Password.
# 1) Enable 2-Step Verification on the Google account.
# 2) Create an App Password (https://myaccount.google.com/apppasswords) and paste
#    the 16-char code (spaces removed) into SMTP_PASS.
# NOTE: With Gmail the FROM_EMAIL address MUST equal SMTP_USER (or a verified
#       "Send mail as" alias), otherwise Gmail rewrites/rejects the sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="ezyloan <your-account@gmail.com>"

# Security alert inbox (failed logins / brute-force / rate-limit hits)
ALERT_EMAIL=dibyanshassociates@gmail.com

# CRM sync — website form submissions (Contact + Apply Now) ko EzyLoanCrm me
# forward karta hai. URL khaali chhodo to sync disable (site normal chalti hai).
# Production: CRM ka live domain daalo, e.g. https://<crm-domain>/api/webhook/lead
CRM_WEBHOOK_URL=http://localhost:3001/api/webhook/lead
# CRM ke LEAD_WEBHOOK_SECRET se EXACTLY match hona chahiye.
CRM_WEBHOOK_SECRET=

# Twilio WhatsApp automation
# Sandbox default FROM is whatsapp:+14155238886 (recipients must opt in with the
# "join <code>" message first). For production use your approved WhatsApp sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Verifies the X-Twilio-Signature on the inbound webhook. Set false only when a
# tunnel rewrites the public URL during local testing.
TWILIO_VALIDATE_SIGNATURE=true
# Production only: approved template Content SID (HX…) used for the on-submit
# message when TWILIO_WHATSAPP_FROM is a real business number (not the sandbox).
# Leave blank in sandbox mode.
TWILIO_WHATSAPP_TEMPLATE_SID=
# Optional: send via a Messaging Service (MG…) instead of the FROM number.
TWILIO_MESSAGING_SERVICE_SID=
# Optional: pin the provider. Twilio is the only supported provider.
WHATSAPP_PROVIDER=twilio

# Public site URL — MUST be the canonical www host (matches metadataBase & all
# JSON-LD). NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time, so changing this
# on the server requires `npm run build` (a pm2 restart alone won't pick it up).
NEXT_PUBLIC_SITE_URL=https://www.ezyloan.co.in

# ── Ezy AI chatbot (bottom-right widget) ─────────────────────────────────────
# The chatbot works fully WITHOUT any of these — the built-in rule engine handles
# products, EMI, eligibility, and lead capture. Add an AI key only if you want the
# bot to answer free-form questions in a richer, ChatGPT-style way (still grounded
# in lib/chatbot/knowledge.ts and bound by the same guardrails). Captured chat
# leads reuse CRM_WEBHOOK_URL + Twilio WhatsApp above — no extra config needed.
#
# RECOMMENDED: Claude (Anthropic). Get a key at https://console.anthropic.com/
# Structured flows (EMI/eligibility/lead) always stay on the rule engine.
ANTHROPIC_API_KEY=
# Model. Default claude-haiku-4-5 (cheap + fast, great for a website bot).
# For smarter answers use claude-sonnet-4-6; for the best quality claude-opus-4-8.
ANTHROPIC_MODEL=claude-haiku-4-5
#
# LEGACY FALLBACK — OpenAI-compatible. Only used if ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Set to "false" to force the deterministic rule engine even if a key is present.
CHATBOT_LLM_ENABLED=true

# === Web Push — admin notifications that work with the app CLOSED ===
# Generate a keypair ONCE: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Put the PUBLIC key in BOTH VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Without these, push is disabled and only the open-app in-app badge runs.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@ezyloan.co.in

# === India-only lead gate (IP geolocation) ===
# Public form submissions (Contact + Apply Now) are blocked when the visitor's
# IP resolves to a country other than India, and each lead records its IP +
# detected country. Lookups use ipwho.is (free, no key) and fail OPEN for
# private/unresolvable IPs so genuine Indian leads are never lost.
# Set to "true" ONLY to temporarily disable blocking (country is still recorded).
DISABLE_GEO_BLOCK=false
